# Default installer configuration for test-with-qemu.sh.
#
# This file is sourced as trusted Bash code by the installer in the guest.  The
# device and runtime paths below are the fixed paths exposed by the QEMU test
# harness.  Create further files in this directory to exercise other layouts.

target_disk=/dev/disk/by-id/nvme-QEMU_NVMe_Ctrl_bootc-root_1
source_imgref=
target_imgref=
install_root=/run/test-install-qemu-bootc/install-root
work_root=/run/test-install-qemu-bootc
bootloader=grub

root_encrypted=true
root_fs_label=test_root
root_subvol=system/root
root_partition_label=test_root_gpt
root_luks_label=test_root_luks
root_tpm2=true
root_tpm2_pcrs=7
root_tpm2_recovery=true
recovery_key_output_file=/run/test-install-qemu-bootc/recovery-keys.txt
luks_ephemeral_key=true
luks_password_file=

# Use the external volume disk for /var. Disable the root-backed subvolume shortcuts
# pending a redesign of their lifecycle and filesystem semantics.
separate_var=false
separate_home=false
separate_opt=false

ext_vol_devices=(/dev/disk/by-id/nvme-QEMU_NVMe_Ctrl_bootc-extra_1)
ext_vol_mountpoint=(/var)
ext_vol_fs=(btrfs)
ext_vol_luks=(var_crypt)
ext_vol_opts=(compress=zstd,noatime)
ext_vol_tpm=(true)
ext_vol_tpm_pcrs=(7)
ext_vol_recovery=(true)
ext_vol_subvol=(var)
ext_vol_subvol_create=(true)

# One of these serial devices is present on each supported architecture.
extra_kargs=(console=tty0 console=ttyS0,115200n8 console=ttyAMA0,115200n8)

# The current installer creates an initial wheel user.  This test-only password
# hash is for the literal password "password".
user_name=test-admin
user_gecos='Test Administrator'
user_shell=/bin/bash
user_password_hash='$6$test-admin$QW3UNpO4IxVQ0qpn8zdce2/0oFzluylL3jPVmiumQKZKnv8RiKcMb6a3I0sftDPYi4pgDkw0iOGQhMeU4Q.fj.'
