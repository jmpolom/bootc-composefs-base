# Existing encrypted-volume regression configuration for QEMU.
target_disk=/dev/disk/by-id/nvme-QEMU_NVMe_Ctrl_bootc-root_1
source_imgref=
target_imgref=
install_root=/run/test-install-qemu-bootc/install-root
work_root=/run/test-install-qemu-bootc
bootloader=grub
vol_list=(vol_root vol_boot vol_esp vol_var)
declare -A vol_root=(
    [action]=create
    [device]="$target_disk"
    [partition_number]=3
    [partition_size]=remainder
    [partition_type]=4f68bce3-e8cd-4db1-96e7-fbcaf984b709
    [partition_label]=root
    [mountpoint]=/
    [fs]=btrfs
    [fs_label]=root
    [mount_options]=compress=zstd,noatime
    [encryption]=luks-create
    [luks_name]=root
    [luks_label]=root_luks
    [credential]=ephemeral
    [tpm2]=true
    [tpm2_pcrs]=7
    [recovery]=true
    [subvol]=root
    [subvol_action]=create
    [phase]=predeploy
)
declare -A vol_boot=(
    [action]=create
    [device]="$target_disk"
    [partition_number]=2
    [partition_size]=1024
    [partition_type]=bc13c2ff-59e6-4262-a352-b275fd6f7172
    [partition_label]=boot
    [mountpoint]=/boot
    [fs]=ext4
    [fs_label]=boot
    [mount_options]=defaults
    [encryption]=none
    [credential]=none
    [subvol_action]=none
    [phase]=predeploy
)
declare -A vol_esp=(
    [action]=create
    [device]="$target_disk"
    [partition_number]=1
    [partition_size]=600
    [partition_type]=ef00
    [partition_label]=boot_efi
    [mountpoint]=/boot/efi
    [fs]=vfat
    [fs_label]=boot_efi
    [mount_options]=defaults
    [encryption]=none
    [credential]=none
    [subvol_action]=none
    [phase]=predeploy
)
declare -A vol_var=(
    [action]=retain
    [device]=/dev/disk/by-id/nvme-QEMU_NVMe_Ctrl_bootc-extra_1
    [mountpoint]=/var
    [fs]=btrfs
    [mount_options]=compress=zstd,noatime
    [encryption]=luks-open
    [luks_name]=existing_var
    [credential]=env
    [subvol]=var
    [subvol_action]=select
    [phase]=postdeploy
)
lvc_existing_var=$(cat /run/test-install-qemu-bootc/qemu-existing-composefs-var.key)
recovery_key_output_file=/run/test-install-qemu-bootc/recovery-keys.txt
extra_kargs=(console=tty0 console=ttyS0,115200n8 console=ttyAMA0,115200n8)
user_name=test-admin
user_gecos='Test Administrator'
user_shell=/bin/bash
user_password_hash='$6$test-admin$QW3UNpO4IxVQ0qpn8zdce2/0oFzluylL3jPVmiumQKZKnv8RiKcMb6a3I0sftDPYi4pgDkw0iOGQhMeU4Q.fj.'
