# Complete installer configuration reference.
# This file uses the Bash env-file format for readability but is not a ready-to-use configuration.

# Set target_disk to the persistent /dev/disk/by-* path for the whole installation disk.
target_disk=/dev/disk/by-id/replace-with-target-disk

# Set source_imgref to a transport-qualified image reference when installing an image other than the
# running container.
source_imgref=docker://quay.io/example/os:latest

# Set target_imgref to the image reference to record in the installed system; bootc derives the
# value when this variable is empty.
target_imgref=quay.io/example/os:latest

# Set install_root to the temporary installation mountpoint; the default is /mnt/bootc-install.
install_root=/mnt/bootc-install

# Set work_root to the temporary writable directory for mounts, keys, and state; the default is
# /run/bootc-installer.
work_root=/run/bootc-installer

# Set rust_log to the RUST_LOG value passed to bootc; the default is info.
rust_log=info

# Define extra_kargs as an indexed array of additional kernel arguments passed to bootc.
extra_kargs=(
    console=ttyS0,115200n8
)

# Set recovery_key_output_file to an absolute path when any volume specifies recovery=true. The
# installer creates or replaces the file with mode 0600 and writes one space-delimited
# "LUKS_UUID RECOVERY_KEY" record for each volume that has recovery-key generation enabled.
recovery_key_output_file=/run/bootc-installer/recovery-keys.txt

# Set user_name to create an initial administrative account; leave it empty to create no account.
user_name=admin

# Set user_gecos to the full name or description associated with the initial administrative account.
user_gecos='Administrator'

# Set user_shell to the login shell for the initial administrative account; the default is
# /bin/bash.
user_shell=/bin/bash

# Set user_password_hash to a crypt-style password hash; an empty value creates a locked account.
user_password_hash=''

# Do not define user_password; the installer rejects plaintext passwords when user_name is set.

# Define lvc_<luks_name> to provide the credential selected by credential=env; the installer
# consumes and unsets this variable.
lvc_archive_crypt='replace-with-secret'

# Set separate_var=true to add a root-backed Btrfs relation at /var; the default is false.
separate_var=false

# Set separate_home=true to add a root-backed Btrfs relation at /var/home; the default is false.
separate_home=false

# Set separate_opt=true to add a root-backed Btrfs relation at /var/opt; the default is false.
separate_opt=false

# Set bootloader to grub or systemd for Composefs; OSTree accepts only grub, which is the default.
bootloader=grub

# Set allow_missing_verity=true to pass --allow-missing-verity to the Composefs installer; the
# default is false.
allow_missing_verity=false

# Set stateroot to an OSTree deployment name that begins with a lowercase letter or digit and
# contains only lowercase letters, digits, periods, underscores, and hyphens.
stateroot=default

# Define vol_list as the ordered list of volume records. It must begin with vol_root, vol_boot, and
# vol_esp, in that order.
vol_list=(
    vol_root
    vol_boot
    vol_esp
    vol_var
    vol_data
    vol_archive
    vol_logs
)

# The following keys define a volume record.
#
# action: Use create to format storage, retain to use existing storage, or relation to share
# another record's Btrfs filesystem.
# device: Specify the whole disk for a partitioned create, the whole device for a direct create,
# or the existing filesystem or LUKS device for a retain record. Relations do not specify device.
# partition_number: Specify the positive GPT partition number to create on device.
# partition_size: Specify a positive size in MiB, or use remainder to consume the largest
# available region.
# partition_type: Specify a GPT type accepted by sgdisk, such as ef00, 8300, or a type GUID.
# partition_label: Specify the GPT partition name exposed under /dev/disk/by-partlabel after
# creation.
# mountpoint: Specify the absolute, normalized path where the volume will be mounted in the
# installed system.
# fs: For action=create, use btrfs, ext4, xfs, or vfat; for action=retain, use a type detected by
# blkid and supported by the kernel.
# fs_label: For action=create, specify a label that begins with a lowercase letter or digit and
# contains only lowercase letters, digits, underscores, and hyphens.
# mount_options: Specify comma-separated mount options without colons or newlines; the default is
# defaults.
# encryption: Use none for an unencrypted volume, luks-create to create a LUKS2 volume, or
# luks-open to open an existing LUKS volume.
# luks_name: Specify the device-mapper name for an encrypted volume; credential=env also uses it
# as the suffix of the lvc_ variable.
# luks_label: Specify the LUKS2 label when encryption=luks-create.
# credential: Use none, prompt, file, env, or ephemeral to select how the installer obtains an
# encryption key.
# credential_file: Specify a readable key-file path when credential=file.
# tpm2: Set this to true to enroll the encrypted volume with TPM2; the default is false.
# tpm2_pcrs: Specify an optional systemd-cryptenroll PCR selection, such as 7 or 0+7.
# recovery: Set this to true to generate a recovery key; the default is false, and recovery
# requires encryption.
# subvol: Specify a safe relative Btrfs subvolume path when subvol_action is select or create.
# subvol_action: Use none to mount the filesystem root, select to use an existing subvolume, or
# create to create or reuse one.
# phase: Use predeploy to mount the volume before bootc, or postdeploy to mount and migrate it
# after bootc.
# backing: Specify the name of an existing volume record when action=relation.
# _partition_device, _source, _luks_uuid, and _fs_uuid: These keys are reserved for installer
# runtime state.
#
# credential=none supplies no key; prompt requests one interactively; file reads credential_file;
# env reads lvc_<luks_name>; and ephemeral generates a temporary key.
# credential=ephemeral requires action=create, encryption=luks-create, and recovery=true.
# Unencrypted volumes require credential=none and cannot enable TPM2 enrollment or recovery-key
# generation.
# Filesystem labels are limited to 255 characters for Btrfs, 16 for ext4, 12 for XFS, and 11 for
# VFAT.
# Partition numbers are independent of vol_list order; each disk may contain only one remainder
# partition.
# Do not include subvol= or subvolid= in mount_options when subvol_action is select or create.

# The vol_root record must set action=create, mountpoint=/, and fs=btrfs. It must also define every
# partition field.
# When partition_size=remainder, the root partition is allocated after all fixed-size partitions
# on the same disk.
declare -A vol_root=(
    [action]=create
    [device]="$target_disk"
    [partition_number]=3
    [partition_size]=remainder
    [partition_type]=4f68bce3-e8cd-4db1-96e7-fbcaf984b709
    [partition_label]=root
    [mountpoint]=/
    [fs]=btrfs
    [fs_label]=root
    [mount_options]=compress=zstd,noatime
    [encryption]=none
    [credential]=none
    [tpm2]=false
    [recovery]=false
    [subvol]=root
    [subvol_action]=create
    [phase]=predeploy
)

# The vol_boot record must set action=create, mountpoint=/boot, and fs=ext4. Its partition must be
# at least 512 MiB.
declare -A vol_boot=(
    [action]=create
    [device]="$target_disk"
    [partition_number]=2
    [partition_size]=1024
    [partition_type]=bc13c2ff-59e6-4262-a352-b275fd6f7172
    [partition_label]=boot
    [mountpoint]=/boot
    [fs]=ext4
    [fs_label]=boot
    [mount_options]=defaults
    [encryption]=none
    [credential]=none
    [tpm2]=false
    [recovery]=false
    [subvol_action]=none
    [phase]=predeploy
)

# The vol_esp record must set action=create, mountpoint=/boot/efi, and fs=vfat. Its partition must
# be at least 128 MiB.
declare -A vol_esp=(
    [action]=create
    [device]="$target_disk"
    [partition_number]=1
    [partition_size]=600
    [partition_type]=ef00
    [partition_label]=boot_efi
    [mountpoint]=/boot/efi
    [fs]=vfat
    [fs_label]=boot_efi
    [mount_options]=defaults
    [encryption]=none
    [credential]=none
    [tpm2]=false
    [recovery]=false
    [subvol_action]=none
    [phase]=predeploy
)

# Additional volumes cannot mount at /, /boot, /boot/*, /etc, /etc/*, /usr, /usr/*,
# /proc, /proc/*, /sys, /sys/*, /dev, /dev/*, /run, /run/*, /state, /state/*,
# /sysroot, or /sysroot/*.
# Only vol_root, vol_boot, and vol_esp may use /, /boot, and /boot/efi, respectively.
# Composefs also rejects /composefs and its descendants; OSTree rejects /ostree and its descendants.

# A whole-device create record specifies device, omits all partition_* keys, and
# erases the entire device before formatting it.
declare -A vol_var=(
    [action]=create
    [device]=/dev/disk/by-id/replace-with-state-disk
    [mountpoint]=/var
    [fs]=btrfs
    [fs_label]=var
    [mount_options]=compress=zstd,noatime
    [encryption]=luks-create
    [luks_name]=var_crypt
    [luks_label]=var_luks
    [credential]=ephemeral
    [tpm2]=true
    [tpm2_pcrs]=7
    [recovery]=true
    [subvol]=var
    [subvol_action]=create
    [phase]=postdeploy
)

# A partitioned volume record defines device and every partition_* key; the partition fields are
# all-or-none.
declare -A vol_data=(
    [action]=create
    [device]=/dev/disk/by-id/replace-with-data-disk
    [partition_number]=1
    [partition_size]=remainder
    [partition_type]=8300
    [partition_label]=data
    [mountpoint]=/data
    [fs]=xfs
    [fs_label]=data
    [mount_options]=defaults
    [encryption]=none
    [credential]=none
    [tpm2]=false
    [recovery]=false
    [subvol_action]=none
    [phase]=postdeploy
)

# A retain record uses an existing filesystem; if the volume is encrypted, the record must set
# encryption=luks-open.
declare -A vol_archive=(
    [action]=retain
    [device]=/dev/disk/by-id/replace-with-existing-volume
    [mountpoint]=/archive
    [fs]=xfs
    [mount_options]=ro
    [encryption]=luks-open
    [luks_name]=archive_crypt
    [credential]=env
    [tpm2]=false
    [recovery]=false
    [subvol_action]=none
    [phase]=postdeploy
)

# A relation record shares its backing record's Btrfs filesystem and defines neither device nor
# partition keys.
declare -A vol_logs=(
    [action]=relation
    [backing]=vol_var
    [mountpoint]=/var/log
    [fs]=btrfs
    [mount_options]=compress=zstd,noatime
    [encryption]=none
    [credential]=none
    [tpm2]=false
    [recovery]=false
    [subvol]=var/log
    [subvol_action]=create
    [phase]=postdeploy
)
