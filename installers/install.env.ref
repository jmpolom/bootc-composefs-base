#!/usr/bin/env bash
# shellcheck disable=SC2034,SC2054,SC2209

# Complete installer configuration reference and example.
# This file is sourced as trusted Bash; quote values containing shell metacharacters.

# target_disk: Required persistent /dev/disk/by-* path to the whole installation disk.
target_disk=/dev/disk/by-id/replace-with-target-disk

# source_imgref: Optional transport-qualified image to install instead of the running container image.
source_imgref=

# target_imgref: Optional image reference recorded in the installed system; bootc derives it when empty.
target_imgref=quay.io/example/os:latest

# install_root: Temporary mountpoint where bootc constructs the installed system.
install_root=/mnt/bootc-install

# work_root: Temporary writable directory used for mounts, generated keys, and installer state.
work_root=/run/bootc-installer

# rust_log: RUST_LOG value passed to bootc, such as info, debug, or bootc=debug.
rust_log=info

# extra_kargs: Optional indexed array of additional kernel arguments passed to bootc.
extra_kargs=(
    # console=ttyS0,115200n8
)

# recovery_key_output_file: Required absolute output path when any volume uses recovery=true.
# The installer replaces this file with mode 0600 and writes one "LUKS_UUID RECOVERY_KEY" line per volume.
recovery_key_output_file=

# user_name: Optional initial administrative account name; leave empty to create no user.
user_name=admin

# user_gecos: Optional descriptive name for the initial administrative account.
user_gecos=Administrator

# user_shell: Login shell assigned to the initial administrative account.
user_shell=/bin/bash

# user_password_hash: Optional crypt-style password hash; an empty value creates a locked account.
# Generate a SHA-512 hash with: openssl passwd -6
user_password_hash=

# user_password: Forbidden plaintext alternative to user_password_hash and must not be set.

# lvc_<luks_name>: Dynamically named credential variable consumed and unset by credential=env.
# lvc_archive_crypt='replace-with-secret'

# separate_var: Boolean shortcut that creates a root-backed Btrfs relation for /var.
separate_var=false

# separate_home: Boolean shortcut that creates a root-backed Btrfs relation for /var/home.
separate_home=false

# separate_opt: Boolean shortcut that creates a root-backed Btrfs relation for /var/opt.
separate_opt=false

# bootloader: Composefs accepts grub or systemd; OSTree accepts only grub.
bootloader=grub

# allow_missing_verity: Composefs-only boolean passed to bootc as --allow-missing-verity.
allow_missing_verity=false

# stateroot: OSTree-only deployment name containing lower-case letters, digits, dot, underscore, or hyphen.
stateroot=default

# vol_list: Required ordered list of associative-array volume records.
# The first three entries must be vol_root, vol_boot, and vol_esp; later record names must start with vol_.
vol_list=(
    vol_root
    vol_boot
    vol_esp
    vol_var
)

# Volume record keys and accepted values:
#
# action: create formats new storage, retain uses an existing filesystem, and relation uses a Btrfs subvolume on another record.
# device: Device path used by a whole-device create or retained volume.
# parent_disk: Whole-disk path partitioned for a created volume; it is used with partition_number.
# partition_number: Positive GPT partition number created on parent_disk.
# partition_size: Positive size in MiB or remainder for the final partition consuming available space.
# partition_type: GPT type accepted by sgdisk, such as ef00 or a canonical type GUID.
# partition_label: GPT partition name used through /dev/disk/by-partlabel after creation.
# mountpoint: Absolute normalized installed-system path where the volume is mounted.
# fs: Created filesystems accept btrfs, ext4, xfs, or vfat; retained filesystems accept a kernel-supported blkid type.
# fs_label: Required create label starting with lower-case alphanumeric and using only lower-case alphanumeric, underscore, or hyphen; limits are Btrfs 255, ext4 16, XFS 12, and VFAT 11.
# mount_options: Comma-separated options without a colon or newline; the default is defaults.
# encryption: none uses the filesystem device, luks-create creates LUKS, and luks-open unlocks existing LUKS; the default is none.
# luks_name: Required device-mapper name for encryption and identifier suffix for credential=env.
# luks_label: Required LUKS2 label when encryption=luks-create.
# credential: none supplies no key, prompt reads interactively, file reads credential_file, env reads lvc_<luks_name>, and ephemeral generates a temporary key; the default is none.
# credential_file: Readable key file required by credential=file.
# credential=ephemeral: Valid only with action=create, encryption=luks-create, tpm2=true, and recovery=true.
# tpm2: Boolean selecting systemd-cryptenroll TPM2 enrollment for an encrypted volume; the default is false.
# tpm2_pcrs: Optional systemd-cryptenroll PCR selection, such as 7 or 0+7.
# recovery: Boolean generating and recording a recovery key; the default is false and true requires tpm2=true.
# subvol: Safe relative Btrfs subvolume path used when subvol_action is select or create.
# subvol_action: none mounts the filesystem root, select mounts an existing subvolume, and create creates or selects it; the default is none.
# phase: predeploy mounts before bootc and postdeploy mounts and migrates after bootc; core records default to predeploy and others to postdeploy.
# backing: Existing volume record supplying storage for action=relation.
#
# _partition_device, _source, _luks_uuid, and _fs_uuid: Reserved runtime keys that must not be configured.

# Core record requirements:
# vol_root must be action=create, mountpoint=/, fs=btrfs, and define all partition fields.
# vol_boot must be action=create, mountpoint=/boot, fs=ext4, and be at least 512 MiB.
# vol_esp must be action=create, mountpoint=/boot/efi, fs=vfat, and be at least 128 MiB.
# Partition numbers are explicit and independent of vol_list order.
# Fixed-size partitions are allocated before a remainder partition on each parent disk.
# Only one remainder partition is practical per parent disk because it consumes the remaining free space.

declare -A vol_root=(
    [action]=create
    [parent_disk]="$target_disk"
    [partition_number]=3
    [partition_size]=remainder
    [partition_type]=4f68bce3-e8cd-4db1-96e7-fbcaf984b709
    [partition_label]=root
    [mountpoint]=/
    [fs]=btrfs
    [fs_label]=root
    [mount_options]=compress=zstd,noatime
    [encryption]=none
    [credential]=none
    [tpm2]=false
    [recovery]=false
    [subvol]=root
    [subvol_action]=create
    [phase]=predeploy
)

declare -A vol_boot=(
    [action]=create
    [parent_disk]="$target_disk"
    [partition_number]=2
    [partition_size]=1024
    [partition_type]=bc13c2ff-59e6-4262-a352-b275fd6f7172
    [partition_label]=boot
    [mountpoint]=/boot
    [fs]=ext4
    [fs_label]=boot
    [mount_options]=defaults
    [encryption]=none
    [credential]=none
    [tpm2]=false
    [recovery]=false
    [subvol_action]=none
    [phase]=predeploy
)

declare -A vol_esp=(
    [action]=create
    [parent_disk]="$target_disk"
    [partition_number]=1
    [partition_size]=600
    [partition_type]=ef00
    [partition_label]=boot_efi
    [mountpoint]=/boot/efi
    [fs]=vfat
    [fs_label]=boot_efi
    [mount_options]=defaults
    [encryption]=none
    [credential]=none
    [tpm2]=false
    [recovery]=false
    [subvol_action]=none
    [phase]=predeploy
)

# A whole-device create omits parent_disk and partition fields and erases device before formatting it.
declare -A vol_var=(
    [action]=create
    [device]=/dev/disk/by-id/replace-with-state-disk
    [mountpoint]=/var
    [fs]=btrfs
    [fs_label]=var
    [mount_options]=compress=zstd,noatime
    [encryption]=luks-create
    [luks_name]=var_crypt
    [luks_label]=var_luks
    [credential]=ephemeral
    [tpm2]=true
    [tpm2_pcrs]=7
    [recovery]=true
    [subvol]=var
    [subvol_action]=create
    [phase]=postdeploy
)

# A partitioned additional volume uses parent_disk plus partition_number, partition_size, partition_type, and partition_label.
# declare -A vol_data=(
#     [action]=create
#     [parent_disk]=/dev/disk/by-id/replace-with-data-disk
#     [partition_number]=1
#     [partition_size]=remainder
#     [partition_type]=8300
#     [partition_label]=data
#     [mountpoint]=/data
#     [fs]=xfs
#     [fs_label]=data
#     [mount_options]=defaults
#     [encryption]=none
#     [credential]=none
#     [tpm2]=false
#     [recovery]=false
#     [subvol_action]=none
#     [phase]=postdeploy
# )

# A retained volume is never formatted and encryption=luks-open unlocks it before checking fs.
# declare -A vol_archive=(
#     [action]=retain
#     [device]=/dev/disk/by-id/replace-with-existing-volume
#     [mountpoint]=/archive
#     [fs]=xfs
#     [mount_options]=ro
#     [encryption]=luks-open
#     [luks_name]=archive_crypt
#     [credential]=file
#     [credential_file]=/run/secrets/archive.key
#     [tpm2]=false
#     [recovery]=false
#     [subvol_action]=none
#     [phase]=postdeploy
# )

# A relation shares its backing record's Btrfs filesystem and may create or select a subvolume.
# declare -A vol_logs=(
#     [action]=relation
#     [backing]=vol_var
#     [mountpoint]=/var/log
#     [fs]=btrfs
#     [mount_options]=compress=zstd,noatime
#     [encryption]=none
#     [credential]=none
#     [tpm2]=false
#     [recovery]=false
#     [subvol]=var/log
#     [subvol_action]=create
#     [phase]=postdeploy
# )

# Mountpoints are rejected at /, /boot, /boot/*, /etc, /etc/*, /usr, /usr/*,
# /proc, /proc/*, /sys, /sys/*, /dev, /dev/*, /run, /run/*, /state, /state/*,
# /sysroot, and /sysroot/* except for the matching mandatory core record.
# Composefs also rejects /composefs and descendants; OSTree also rejects /ostree and descendants.
