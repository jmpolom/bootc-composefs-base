# This file is sourced by Bash. Quote values containing shell metacharacters.

# Required. Must identify a whole disk through a persistent udev/systemd path.
target_disk=/dev/disk/by-id/replace-with-target-disk

# bootc image references. Leave source_imgref empty to install the running container image. Set it
# only to install a different image, using a containers/image transport-qualified reference such as
# docker://quay.io/example/os:latest. When target_imgref is empty, bootc derives it from the source.
source_imgref=
target_imgref=quay.io/example/os:latest

# Disk sizing in MiB. The remaining space becomes the Btrfs root partition.
efi_size_mib=600
boot_size_mib=1024

# Optional LUKS2 encryption. The installer prompts interactively for the initial passphrase.
root_encrypted=false
luks_name=root

# Noninteractive LUKS setup. Leave both settings disabled/empty to retain interactive passphrase
# prompts. With luks_ephemeral_key=true, each encrypted volume receives a temporary random key that
# is removed after its recovery and TPM2 enrollments succeed. Alternatively, provide one readable
# password file; its key slot is retained on every encrypted volume.
luks_ephemeral_key=false
luks_password_file=

# Optional per-volume TPM2 enrollment. An empty PCR value omits --tpm2-pcrs and therefore uses the
# systemd-cryptenroll default. Recovery enrollment writes the generated key to the configured file.
root_tpm2=false
root_tpm2_pcrs=''
root_tpm2_recovery=false

# Required when any recovery enrollment is enabled. The file is replaced with mode 0600 and contains
# one whitespace-delimited "LUKS_UUID RECOVERY_KEY" record per encrypted volume.
recovery_key_output_file=

# Legacy state switches. Before validation, each true switch is normalized into one ordinary
# an ext_vol_* record. The generated record selects a Btrfs subvolume in the new root filesystem;
# it does not wipe, format, relabel, or separately encrypt the root filesystem. An explicit external
# volume with the same literal target as a true switch is rejected as a collision.
separate_var=false
separate_home=false
separate_opt=false

# Optional external volumes. Required arrays must have matching lengths. Created records (the
# default) identify whole disks that are wiped and formatted directly, without a partition table;
# records with ext_vol_existing=true may identify an existing disk, partition, LV, or mapper.
# Optional arrays use the same index; omitted or empty entries select defaults.
#
# Keep each ext_vol_mountpoint value as the literal installed-tree target. Targets are never
# rewritten below /var (for example, /home, /opt, /srv, and /data remain those exact paths).
# An existing directory is used as-is, a missing directory and its parents are created, and an
# image symlink or other non-directory is rejected unchanged; it is never replaced, unlinked, or
# renamed by target preparation.
# Mount targets are absolute, normalized, unique, and ordered parent before child. Every record
# rejects /, /boot and descendants, /etc and descendants, /usr and descendants except /usr/local
# and descendants, /proc, /sys, /dev, /run, and /sysroot trees. Composefs additionally rejects
# /composefs and /state trees; OSTree additionally rejects the /ostree tree. External /etc storage
# is intentionally out of scope. Legacy external-mount variables are ignored.
ext_vol_devices=(
    # /dev/vdb
    # /dev/vdc
)
ext_vol_mountpoint=(
    # /var/lib/containers
    # /srv
)
ext_vol_fs=(
    # xfs
    # btrfs
)
ext_vol_luks=(
    # Empty for plaintext; otherwise the lower-case mapper name, e.g. srv_crypt.
    # ''
    # srv_crypt
)
# For an existing encrypted record, set the raw password or systemd recovery key in the process
# environment as lvc_<mapper_name> (or assign it in this sourced config). It is materialized only
# while the volume is opened/enrolled and removed before bootc is invoked. Existing-volume
# enrollment is additive: filesystem identity, LUKS UUID, and existing key slots are retained.
ext_vol_opts=(
    # noatime
    # compress=zstd,noatime
)
ext_vol_tpm=(
    # false
    # true
)
ext_vol_tpm_pcrs=(
    # ''
    # '7+11'
)
ext_vol_recovery=(
    # false
    # true
)
ext_vol_existing=(
    # false creates and formats the selected whole disk; true retains an existing volume.
    # false
    # false
)

# Mount-option settings apply to created and existing storage. A colon is reserved by the
# systemd.mount-extra encoding
# (WHAT:WHERE:FSTYPE:OPTIONS), so state and external volume options cannot contain ':'.
root_mount_options=compress=zstd,noatime
state_mount_options=compress=zstd,noatime

# Optional first administrative user. Generate a hash with: openssl passwd -6
user_name=admin
user_gecos='Administrator'
user_shell=/bin/bash
user_password_hash=''

# Passed directly to bootc. Use debug or bootc=debug for more Rust tracing.
rust_log=info

# Optional additional kernel arguments, using Bash array syntax.
extra_kargs=(
    # 'console=ttyS0,115200n8'
)

# Optional working paths.
install_root=/mnt/bootc-install
work_root=/run/bootc-installer

# Composefs settings. The composefs installer accepts grub or systemd and uses the native
# composefs backend. allow_missing_verity is passed only to that installer.
bootloader=grub
allow_missing_verity=false

# OSTree settings. The OSTree installer supports GRUB only and installs into this stateroot.
stateroot=default
