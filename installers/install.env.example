# This file is sourced by Bash. Quote values containing shell metacharacters.

# Required. Must identify a whole disk through a persistent udev/systemd path.
target_disk=/dev/disk/by-id/replace-with-target-disk

# bootc image references. Leave source_imgref empty to install the running container image. Set it
# only to install a different image, using a containers/image transport-qualified reference such as
# docker://quay.io/example/os:latest. When target_imgref is empty, bootc derives it from the source.
source_imgref=
target_imgref=quay.io/example/os:latest

# Storage records are named associative arrays. The first three records are mandatory and
# always mean root, /boot, and the UEFI ESP; partition_number is independent of list order.
vol_list=(vol_root vol_boot vol_esp vol_var)
declare -A vol_root=(
    [action]=create [parent_disk]="$target_disk" [partition_number]=3 [partition_size]=remainder
    [partition_type]=4f68bce3-e8cd-4db1-96e7-fbcaf984b709 [partition_label]=root
    [mountpoint]=/ [fs]=btrfs [fs_label]=root [mount_options]=compress=zstd,noatime
    [encryption]=none [credential]=none [subvol]=root [subvol_action]=create [phase]=predeploy
)
declare -A vol_boot=(
    [action]=create [parent_disk]="$target_disk" [partition_number]=2 [partition_size]=1024
    [partition_type]=bc13c2ff-59e6-4262-a352-b275fd6f7172 [partition_label]=boot
    [mountpoint]=/boot [fs]=ext4 [fs_label]=boot [mount_options]=defaults
    [encryption]=none [credential]=none [subvol_action]=none [phase]=predeploy
)
declare -A vol_esp=(
    [action]=create [parent_disk]="$target_disk" [partition_number]=1 [partition_size]=600
    [partition_type]=ef00 [partition_label]=boot_efi [mountpoint]=/boot/efi [fs]=vfat
    [fs_label]=boot_efi [mount_options]=defaults [encryption]=none [credential]=none
    [subvol_action]=none [phase]=predeploy
)
declare -A vol_var=(
    [action]=create [device]=/dev/disk/by-id/replace-with-state-disk [mountpoint]=/var
    [fs]=btrfs [fs_label]=var [mount_options]=compress=zstd,noatime [encryption]=none
    [credential]=none [subvol]=var [subvol_action]=create [phase]=postdeploy
)

# Required when any recovery enrollment is enabled. The file is replaced with mode 0600 and contains
# one whitespace-delimited "LUKS_UUID RECOVERY_KEY" record per encrypted volume.
recovery_key_output_file=

# Convenience switches generate named root-backed relation records before validation. An explicit
# record with the same mountpoint conflicts with the switch.
separate_var=false
separate_home=false
separate_opt=false

# Additional records use action=create, action=retain, or action=relation. Created records identify
# whole disks unless parent_disk and partition_number are provided. Retained records never format
# media and may use any filesystem supported by the kernel. Relations name a backing record.
#
# Keep each mountpoint value as the literal installed-tree target. Targets are never
# rewritten below /var (for example, /home, /opt, /srv, and /data remain those exact paths).
# An existing directory is used as-is, a missing directory and its parents are created, and an
# image symlink or other non-directory is rejected unchanged; it is never replaced, unlinked, or
# renamed by target preparation.
# Mount targets are absolute, normalized, unique, and ordered parent before child. Every record
# rejects /, /boot and descendants, /etc and descendants, /usr and descendants except /usr/local
# and descendants, /proc, /sys, /dev, /run, and /sysroot trees. Composefs additionally rejects
# /composefs and /state trees; OSTree additionally rejects the /ostree tree. External /etc storage
# is intentionally out of scope. Legacy external-mount variables are ignored.
# For an encrypted retained record, credential=env reads lvc_<luks_name> and erases it immediately.
# credential=file requires credential_file. credential=ephemeral is valid only for luks-create and
# removes its password slot after TPM and recovery enrollment. Recovery always requires TPM2.

# Optional first administrative user. Generate a hash with: openssl passwd -6
user_name=admin
user_gecos='Administrator'
user_shell=/bin/bash
user_password_hash=''

# Passed directly to bootc. Use debug or bootc=debug for more Rust tracing.
rust_log=info

# Optional additional kernel arguments, using Bash array syntax.
extra_kargs=(
    # 'console=ttyS0,115200n8'
)

# Optional working paths.
install_root=/mnt/bootc-install
work_root=/run/bootc-installer

# Composefs settings. The composefs installer accepts grub or systemd and uses the native
# composefs backend. allow_missing_verity is passed only to that installer.
bootloader=grub
allow_missing_verity=false

# OSTree settings. The OSTree installer supports GRUB only and installs into this stateroot.
stateroot=default
