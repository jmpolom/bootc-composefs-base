# Bash sources this file directly. Quote values that contain shell metacharacters.
# See install.env.ref for the complete variable and volume-key reference.

# Required. Specify the entire target disk using a persistent path managed by udev or systemd.
target_disk=/dev/disk/by-id/replace-with-target-disk

# Leave source_imgref empty to install the running container image. To install another image, use a
# containers/image transport-qualified reference, such as docker://quay.io/example/os:latest.
# When target_imgref is empty, bootc derives the installed image reference from the source image.
source_imgref=
target_imgref=

# Storage records are named associative arrays. The first three records are mandatory and
# represent the root filesystem, /boot, and the UEFI system partition (ESP), respectively.
# A record's partition_number is independent of its position in the list.
vol_list=(vol_root vol_boot vol_esp vol_var)
declare -A vol_root=(
    [action]=create [device]="$target_disk" [partition_number]=3 [partition_size]=remainder
    [partition_type]=4f68bce3-e8cd-4db1-96e7-fbcaf984b709 [partition_label]=root
    [mountpoint]=/ [fs]=btrfs [fs_label]=root [mount_options]=compress=zstd,noatime
    [encryption]=none [credential]=none [subvol]=root [subvol_action]=create [phase]=predeploy
)
declare -A vol_boot=(
    [action]=create [device]="$target_disk" [partition_number]=2 [partition_size]=1024
    [partition_type]=bc13c2ff-59e6-4262-a352-b275fd6f7172 [partition_label]=boot
    [mountpoint]=/boot [fs]=ext4 [fs_label]=boot [mount_options]=defaults
    [encryption]=none [credential]=none [subvol_action]=none [phase]=predeploy
)
declare -A vol_esp=(
    [action]=create [device]="$target_disk" [partition_number]=1 [partition_size]=600
    [partition_type]=ef00 [partition_label]=boot_efi [mountpoint]=/boot/efi [fs]=vfat
    [fs_label]=boot_efi [mount_options]=defaults [encryption]=none [credential]=none
    [subvol_action]=none [phase]=predeploy
)
declare -A vol_var=(
    [action]=create [device]=/dev/disk/by-id/replace-with-state-disk [mountpoint]=/var
    [fs]=btrfs [fs_label]=var [mount_options]=compress=zstd,noatime [encryption]=none
    [credential]=none [subvol]=var [subvol_action]=create [phase]=postdeploy
)

# Required when recovery-key generation is enabled for any volume. The installer creates or replaces
# this file with mode 0600 and writes one space-delimited "LUKS_UUID RECOVERY_KEY" record for each
# volume that has recovery-key generation enabled.
recovery_key_output_file=

# These convenience switches add named relation records backed by the root Btrfs filesystem before
# validation. Do not enable a switch when an explicit record uses the same mountpoint.
separate_var=false
separate_home=false
separate_opt=false

# Additional records use action=create, action=retain, or action=relation. A create record uses an
# entire device unless partition_number and every other partition_* field identify a partition to
# create on device. A retain
# record uses an existing filesystem and must specify encryption=luks-open when that filesystem is
# encrypted. A relation record identifies another record as its backing storage.
#
# Specify each mountpoint exactly as it should appear in the installed system; the installer never
# rewrites paths beneath /var. For example, /home, /opt, /srv, and /data remain unchanged. Existing
# directories are preserved, and missing directories and their parents are created. If the image
# contains a symbolic link or another non-directory at the target path, validation fails without
# replacing, unlinking, or renaming it.
# Mountpoints must be absolute, normalized, unique, and ordered with parents before children.
# Additional records cannot use /, /boot or its descendants, or any path in the /etc, /usr, /proc,
# /sys, /dev, /run, /state, or /sysroot trees. Composefs also rejects the /composefs tree, and
# OSTree rejects the /ostree tree. External storage mounted at /etc is intentionally unsupported.
# For an encrypted retain record, credential=env reads lvc_<luks_name> and immediately unsets it.
# credential=file requires credential_file. credential=ephemeral applies only to luks-create and
# removes its password slot after recovery-key enrollment and any requested TPM2 enrollment.
# Recovery-key generation requires encryption, not TPM2 enrollment.

# Optionally create an initial administrative user. Generate a password hash with: openssl passwd -6
user_name=admin
user_gecos='Administrator'
user_shell=/bin/bash
user_password_hash=''

# Pass this value directly to bootc as RUST_LOG. Use debug or bootc=debug for more detailed tracing.
rust_log=info

# Specify optional additional kernel arguments using Bash array syntax.
extra_kargs=(
    # 'console=ttyS0,115200n8'
)

# Override the default installation and working paths if necessary.
install_root=/mnt/bootc-install
work_root=/run/bootc-installer

# Composefs settings. The Composefs installer accepts grub or systemd and uses the native
# Composefs backend. Only this installer uses allow_missing_verity.
bootloader=grub
allow_missing_verity=false

# OSTree settings. The OSTree installer supports only GRUB and installs into the specified
# stateroot.
stateroot=default
